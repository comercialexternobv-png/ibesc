# URL pública usada em canonical, sitemap e compartilhamento social.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Projeto Supabase. A chave secreta deve existir somente no servidor/hospedagem.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Compatibilidade com projetos Supabase que ainda usam a chave legada.
# SUPABASE_SERVICE_ROLE_KEY=

# Sincronização opcional dos leads com a planilha operacional do Google.
# Ambos os valores ficam somente no servidor/hospedagem.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SYNC_TOKEN=
